DATABASE_URL=postgres://user:password@host:5432/dbname
PORT=3000

# AI draft layer (optional). If ANTHROPIC_API_KEY is unset, AI draft
# generation fails gracefully (ai_status='failed') without affecting RSS
# collection or item creation.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Alternative: set AI_PROVIDER=gemini and use these instead
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
