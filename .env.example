DATABASE_URL=postgres://user:password@host:5432/dbname
PORT=3000

# AI draft layer (optional). If FREELLMAPI_API_KEY is unset, AI draft
# generation fails gracefully (ai_status='failed') without affecting RSS
# collection or item creation. Backed by a self-hosted FreeLLMAPI router
# (https://github.com/tashfeenahmed/freellmapi), OpenAI-compatible API.
FREELLMAPI_BASE_URL=https://your-freellmapi-router.example.com/v1
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto
