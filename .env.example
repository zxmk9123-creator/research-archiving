# Environment variables. Copy to .env for local use; on Vercel set them in Project Settings > Environment Variables.
# Never commit real values. REQUIRED = the app or a core job does not work without it.

# ---- REQUIRED ---------------------------------------------------------------------------------------------------------------------
DATABASE_URL=postgres://user:password@host:5432/dbname
# Admin login password. Unset = nobody can log in (fails closed). The session cookie signature is derived from it: use a long random value.
ADMIN_PASSWORD=
# Bearer token for /api/cron/* (Vercel Cron sends it automatically; the GitHub Actions workflow needs the SAME value as the
# repository secret CRON_SECRET). Unset = every cron endpoint answers 401, so no scheduled collection or headline runs.
CRON_SECRET=

# ---- AI draft / search / headline layer -------------------------------------------------------------------------------------------
# Self-hosted FreeLLMAPI router (https://github.com/tashfeenahmed/freellmapi), OpenAI-compatible API. If FREELLMAPI_API_KEY is unset,
# AI draft generation fails gracefully (ai_status='failed') without affecting RSS collection or item creation.
FREELLMAPI_BASE_URL=https://your-freellmapi-router.example.com/v1
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto
# Optional: a separate key for the chat lane, a faster first-attempt model and the stall-retry timings (ms).
# FREELLMAPI_CHAT_API_KEY=
# FREELLMAPI_FAST_MODEL=
# FREELLMAPI_FAST_MODEL_TIMEOUT_MS=8000
# FREELLMAPI_STALL_RETRY=off          # "off" disables the stall retry
# FREELLMAPI_STALL_FIRST_MS=25000
# FREELLMAPI_STALL_SECOND_MS=35000

# ---- Web search tiers for discovery (order: Brave, Tavily, Firecrawl, SerpApi; each tier is used only when the earlier ones fail) ----
# Each accepts NAME, NAME_2, NAME_3 ... or NAMES (comma list, e.g. BRAVE_SEARCH_API_KEYS); names are case-insensitive.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
SERPAPI_API_KEY=
# TAVILY_MIN_GAP_MS=700
# FIRECRAWL_MIN_GAP_MS=1100
# SERPAPI_MIN_GAP_MS=400

# ---- Market data feed for the Headlines dashboard (optional) ----------------------------------------------------------------------
# Exchange real-time/delayed access and public display rights must be agreed with the provider/exchange separately.
# Data stays disabled unless BOTH the API key and the explicit display approval flag are configured (see docs/market-data.md).
BARCHART_ONDEMAND_API_KEY=
BARCHART_DATA_DISPLAY_ENABLED=false

# ---- Feature switches: set to "off" to disable (default: on) ---------------------------------------------------------------------
# AUTO_REVIEW=off            autonomous review/publish
# VERIFICATION_ROUTINE=off   weak-evidence verification queue
# ENTITY_REGISTRY=off        company registry updates
# ENTITY_MAINTENANCE=off     daily entity maintenance job
# COMPANY_RELATIONS=off      company-relation extraction
# ITEM_FACTS=off             quantity-fact extraction
# TERM_EXPANSION=off         cross-language query expansion
# AI_SEARCH_CACHE=off        AI answer cache
# ROSTER_CACHE=off           company roster cache
# URL_MEMO=off               URL fetch memo

# ---- Tuning (defaults in parentheses) --------------------------------------------------------------------------------------------
# AI_SEARCH_RATE_MAX=40                    AI search requests per address per 10 minutes (per server instance)
# AI_SEARCH_VERIFICATION_TIMEOUT_MS=       citation-verification time limit
# DATASET_PENDING_LIMIT=                   max pending extractions before a dataset answer is built
# CRON_BUDGET_MS=240000                    time budget of one /api/cron/daily call
# PG_POOL_MAX=20                           database pool size

# ---- Platform / local ------------------------------------------------------------------------------------------------------------
PORT=3000
# NODE_ENV=production        enables the Secure flag on the admin session cookie
# PGSSL=false                disable TLS to Postgres (local/CI database only)
# SOURCE_DATABASE_URL=       one-off data move source for /api/cron/migrate-data (leave unset otherwise)
# SMOKE_BASE_URL= / SMOKE_SEED_ITEM_ID=    used by scripts/ciSmokeTest.js (set by CI)
# VERCEL, VERCEL_REGION, VERCEL_PROJECT_PRODUCTION_URL, VERCEL_URL are provided by Vercel; do not set them.
