{
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{server/**,node_modules/@napi-rs/**,node_modules/pdf-parse/dist/pdf-parse/cjs/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron/daily",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/daily",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/daily",
      "schedule": "0 1 * * *"
    }
  ],
  "regions": [
    "iad1"
  ]
}
